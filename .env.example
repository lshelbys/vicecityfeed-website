# Public Supabase project (anon role). These are inlined at `next build`
# because GitHub Pages serves a static export — there is no server to read env
# at request time. Rebuild after changing them.
#
# The live site already ships a public fallback in lib/supabase-public.ts.
# Leave these unset locally if you want to use that fallback.
# Never put a service-role key in the client or commit one.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
